# Copy this file to ".env" and fill in your own values. NEVER commit the real .env file.

# Server port
PORT=5000

# MongoDB connection string.
# Local MongoDB:   mongodb://127.0.0.1:27017/servicehub
# MongoDB Atlas:   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/servicehub?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/servicehub

# Address of the React app (allowed by CORS). Use commas for more than one.
CLIENT_URL=http://localhost:5173

# development or production
NODE_ENV=development

# Used only by the seed script for the demo accounts
SEED_PASSWORD=Password123
